# Camera Configuration
CAMERA_PROTOCOL=rtsp
CAMERA_USER=admin
CAMERA_PASS=password123
CAMERA_IP=192.168.1.100
CAMERA_PORT=554
CAMERA_PATH=/stream1
CAMERA_TRANSPORT=tcp

# Application Settings
CONFIDENCE_THRESHOLD=0.6
QUEUE_MAXSIZE=300

# Model Configuration
YOLO_MODEL=yolov8n.pt
CLASSIFIER_MODEL=bus_classifier_resnet18.pth

# Directories
DETECTIONS_DIR=detections
CLASSIFIED_CORRECT=classified/correct
CLASSIFIED_FALSE=classified/false
CLASSIFIED_UNKNOWN=classified/unknown

USE_GPU=true
DEVICE=cuda